# Telegram (BotFather) — Ivan
TELEGRAM_BOT_TOKEN=

# Sponsor tools — Julius (scouts)
TAVILY_API_KEY=
DAYTONA_API_KEY=

# Model — brains' AI calls go through AgentField app.ai() (LiteLLM) when attached.
# AI_MODEL=gpt-4o needs OPENAI_API_KEY; AI_MODEL=anthropic/claude-opus-5-5 needs ANTHROPIC_API_KEY.
# No AgentField app attached: brains falls back to Anthropic directly, else rules-only.
AI_MODEL=gpt-4o
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# BRAINS_LLM=0  # forces rules-only (fast, deterministic — if the model is slow on stage)

# Data source switches (Ivan)
# USE_FAKE_DATA=1 -> fake_data.json (default until the T+45 integration)
# DEMO_MODE=1     -> demo_data/buy.json + demo_data/sell.json (Julius's saved real results, T+70)
# both 0          -> live scouts + brains
USE_FAKE_DATA=1
DEMO_MODE=0

# AgentField orchestration (optional; needs `af server` running and `pip install agentfield`)
USE_AGENTFIELD=0
SCOUT_NODE=scouts
BRAIN_NODE=brains
# Model for brains (Kiril) — OpenRouter, default Claude Haiku 5.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
